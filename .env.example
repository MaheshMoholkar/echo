# Copy to .env (gitignored) and fill in. Read by the api, the voice bot and
# the Next.js app (the Makefile exports it for Next.js).

# Postgres 17 with pgvector. Better Auth's tables go in the `auth` schema,
# the app's in `public`.
DATABASE_URL=postgres://echo:echo@localhost:5432/echo

# Better Auth: a random secret (openssl rand -base64 32) and the app's URL.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Optional, with their defaults:
# API_URL=http://127.0.0.1:8000     # where Next.js proxies /api/v1
# VOICE_URL=http://127.0.0.1:8001   # where Next.js proxies /api/voice
# VOICE_HOST=127.0.0.1              # where the voice bot listens
# VOICE_PORT=8001
# OLLAMA_BASE_URL=http://localhost:11434/v1
# CHAT_MODEL=qwen3.5:4b
# EMBEDDING_MODEL=nomic-embed-text
# OCR_MODEL=glm-ocr:q8_0
